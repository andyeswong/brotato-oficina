{
  "name": "brotato-oficina",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "validate": "vitest run test/content.test.ts",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run validate && npm run lint && npm run typecheck",
    "build": "vite build",
    "preview": "vite preview --host",
    "curva": "CURVA=1 vitest run scripts/curve.test.ts --silent=false",
    "deploy": "npm run build && systemctl --user restart brotato-preview"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
