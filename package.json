{
  "name": "brotato-oficina",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Brotato de la oficina: un arena-shooter de oleadas sobre el motor de vóxeles VoxPix.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "vite --config app/vite.config.ts",
    "build": "vite build --config app/vite.config.ts",
    "preview": "vite preview --config app/vite.config.ts",
    "rigs": "tsx --tsconfig tsconfig.json scripts/rig-preview.ts",
    "favicon": "tsx --tsconfig tsconfig.json scripts/favicon.ts",
    "models": "node scripts/import-models.mjs",
    "models:check": "node scripts/import-models.mjs --check"
  },
  "dependencies": {
    "voxpix": "github:andyeswong/voxpix#93db4f1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
