{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "baseUrl": ".",
    "paths": {
      "@voxpix/*": [
        "node_modules/voxpix/src/*"
      ],
      "pxl-core": [
        "node_modules/voxpix/vendor/pxl-core.d.ts"
      ]
    },
    "noEmit": true
  },
  "include": [
    "src",
    "test",
    "app/src",
    "scripts"
  ]
}
